GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_THINKING_LEVEL=medium
GEMINI_FALLBACK_MODELS=gemini-3.7-flash
GROQ_API_KEY=
GROQ_MODEL=
CEREBRAS_API_KEY=
CEREBRAS_MODEL=

AI_PROVIDERS=gemini,groq,cerebras
ENABLE_LOCAL_TTS=false

DATABASE_PATH=data/kasper.db

ADMIN_ID=
TELEGRAM_BOT_TOKEN=

# Часовой пояс бота по умолчанию (для пользователей, которые не задали свой через /tz).
# Лимиты сбрасываются в полночь по этому поясу.
BOT_TIMEZONE=Europe/Moscow

# Веб-поиск (Tavily)
TAVILY_API_KEY=

# Второй ключ Groq (запросы распределяются между ключами)
GROQ_API_KEY_2=
